      <div class="col-md-3 col-lg-2 sidebar p-3">
        <h4 class="text-white mb-4">
          <i class="fas fa-school"></i> School System
        </h4>
        <nav class="nav flex-column">
         <%# <%= link_to '<i class="fas fa-building"></i> Schools List'.html_safe, schools_path, class: 'nav-link' %> %
         <%# <%= link_to '<i class="fas fa-plus"></i> Add School'.html_safe, new_school_path, class: 'nav-link' %> %

