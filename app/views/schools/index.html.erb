
    <div class="container-fluid">
        <div class="row">
          

            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 main-content p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i class="fas fa-building"></i> Schools Management</h2>
                    <a href="" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add New School
                    </a>
                </div>

                <!-- Search Box -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <input type="text" class="form-control" id="schoolSearch" placeholder="Search by name or status..." onkeyup="searchSchools()">
                    </div>
                </div>

                <!-- Schools Table -->
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>English Name</th>
                                <th>Arabic Name</th>
                                <th>Status</th>
                                <th>Address</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="schoolsTableBody">
                            <% @schools.each do | school |%>
                            <tr>
                                <td><%= school.name_en %></td>
                                <td><%= school.name_ar%></td>
                                <td>
                                <span class="status-<%= school.status == 0 ? 'active' : 'inactive' %> <%= 'text-danger' if school.status != 0 %>">
                                    <%= school.status == 0 ? 'active' : 'inactive' %>
                                </span>
                                </td>
                                <td>123 Main Street, City</td>
                            <td class="d-flex">
                            <%= link_to class: "btn btn-info btn-sm" do %>
                                <i class="fas fa-eye"></i>
                            <% end %>
                            <%= link_to class: "btn btn-warning btn-sm me-1 ms-1" do %>
                                <i class="fas fa-edit"></i>
                            <% end %>
                            <%= button_to method: :delete, data: { confirm: "Are you sure you want to delete this school? This will also affect related students." }, class: "btn btn-danger btn-sm" do %>
                                <i class="fas fa-trash"></i>
                            <% end %>
                            </td>

                            </tr>
                            <% end %>
                           
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function searchSchools() {
            const searchTerm = document.getElementById('schoolSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#schoolsTableBody tr');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function deleteSchool(id) {
            if (confirm('Are you sure you want to delete this school? This will also affect related students.')) {
                alert('School deleted! (UI Only - Connect to Rails backend)');
                // In Rails, this would redirect or refresh the page
            }
        }
    </script>
