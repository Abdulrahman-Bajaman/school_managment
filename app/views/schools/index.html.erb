<script>
document.addEventListener("DOMContentLoaded", () => {
  let currentFilter = "name_en";

  // Update filter on dropdown item click but DO NOT trigger search here
  document.querySelectorAll(".dropdown-item").forEach(item => {
    item.addEventListener("click", e => {
      e.preventDefault();
      currentFilter = e.target.dataset.filter;
      // No search call here
    });
  });

  const input = document.getElementById("schoolSearch");

  function debounce(func, delay) {
    let timeoutId;
    return function(...args) {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        func.apply(this, args);
      }, delay);
    };
  }

  // Only trigger search on input with debounce
  input.addEventListener("input", debounce(() => {
    searchSchools();
  }, 500));

  function searchSchools() {
    const term_search = input.value.trim();

    fetch(`/schools/search?filter=${currentFilter}&term_search=${encodeURIComponent(term_search)}`)
      .then(response => response.json())
      .then(data => {
        const tbody = document.getElementById("schoolsTableBody");
        tbody.innerHTML = "";

        if (data.schools.length === 0) {
          const noResultRow = document.createElement("tr");
          const noResultCell = document.createElement("td");
          noResultCell.colSpan = 5;
          noResultCell.classList.add("text-center");
          noResultCell.textContent = "No schools found.";
          noResultRow.appendChild(noResultCell);
          tbody.appendChild(noResultRow);
          return;
        }

        data.schools.forEach(school => {
          const tr = document.createElement("tr");

          tr.innerHTML = `
            <td>${school.name_en}</td>
            <td>${school.name_ar}</td>
            <td>
              <span class="status-${school.status == 0 ? 'active' : 'inactive'} ${school.status != 0 ? 'text-danger' : ''}">
                ${school.status == 0 ? 'active' : 'inactive'}
              </span>
            </td>
            <td>123 Main Street, City</td>
            <td class="d-flex">
              <a href="#" class="btn btn-info btn-sm me-1"><i class="fas fa-eye"></i></a>
              <a href="#" class="btn btn-warning btn-sm me-1"><i class="fas fa-edit"></i></a>
              <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
            </td>
          `;

          tbody.appendChild(tr);
        });
      })
      .catch(error => {
        console.error("Error fetching schools:", error);
      });
  }
});
</script>
