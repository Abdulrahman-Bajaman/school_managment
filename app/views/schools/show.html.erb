   <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h3><i class="fas fa-building"></i> School Details</h3>
                                <div>
                                    <a href="school-edit.html?id=1" class="btn btn-primary btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="schools-list.html" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-arrow-left"></i> Back
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <strong>English Name:</strong>
                                        <p class="mb-0"><%= @school.name_en %></p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <strong>Arabic Name:</strong>
                                        <p class="mb-0"><%= @school.name_ar %></p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <strong>Status:</strong>
                                            <p class="mb-0">
                                            <span class="status-<%= @school.status == 0 ? 'active' : 'inactive' %>">
                                                <%= @school.status == 0 ? "active" : "inactive" %>
                                            </span>
                                            </p>
                                                                                </div>
                                    <div class="col-md-6 mb-3">
                                        <strong>Address:</strong>
                                        <p class="mb-0"><%= @school.address %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>