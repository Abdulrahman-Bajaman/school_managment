<%= form_with model: @school, local: true do |form| %>
  <div class="row">
    <div class="col-md-6 mb-3">
    <%= form.label :name_en, "English Name *", class: "form-label" %>
    <%= form.text_field :name_en, class: "form-control", required: true, pattern: "[A-Za-z\s]+",
     oninvalid: "this.setCustomValidity('Please enter English letters only.')", oninput: "setCustomValidity('')" %>
    </div>

    <div class="col-md-6 mb-3">
    <%= form.label :name_ar, "Arabic Name *", class: "form-label" %>
    <%= form.text_field :name_ar, class: "form-control", required: true, pattern: "[\u0600-\u06FF\s]+", oninvalid: "this.setCustomValidity('Please enter Arabic letters only.')", oninput: "setCustomValidity('')" %>
    <div class="invalid-feedback">Please enter Arabic letters only.</div>
    </div>

  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :status, "Status *", class: "form-label" %>
      <%= form.select :status, School.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "form-select", required: true %>
      <div class="invalid-feedback"></div>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :address, "Address", class: "form-label" %>
      <%= form.text_field :address, class: "form-control" %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" do %>
      <i class="fas fa-save"></i> Save School
    <% end %>
    <%= link_to schools_path, class: "btn btn-secondary" do %>
      <i class="fas fa-times"></i> Cancel
    <% end %>
  </div>
<% end %>
