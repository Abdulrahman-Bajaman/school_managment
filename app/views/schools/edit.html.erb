     <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h3><i class="fas fa-edit"></i> Edit School</h3>
                            </div>
                            <div class="card-body">
                               <%= form_with(model: @school, local: true, html: { id: "schoolForm" }) do |form| %>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                    <%= form.label :name_en, "English Name *", class: "form-label" %>
                                    <%= form.text_field :name_en, class: "form-control", pattern: "[A-Za-z\s]+", required: true,
                                        oninvalid: "this.setCustomValidity('Please enter English letters only.')",
                                        oninput: "this.setCustomValidity('')" %>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                    <%= form.label :name_ar, "Arabic Name *", class: "form-label" %>
                                    <%= form.text_field :name_ar, class: "form-control", pattern: "[\u0600-\u06FF\s]+", required: true,
                                        oninvalid: "this.setCustomValidity('Please enter Arabic letters only.')",
                                        oninput: "this.setCustomValidity('')" %>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                    <%= form.label :status, "Status *", class: "form-label" %>
                                    <%= form.select :status, options_for_select([["Active", "active"], ["Inactive", "inactive"]], @school.status),
                                        { prompt: "Select Status" }, class: "form-select", required: true %>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                    <%= form.label :address, "Address", class: "form-label" %>
                                    <%= form.text_field :address, class: "form-control" %>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <%= form.submit "Update School", class: "btn btn-primary" %>
                                    <%= link_to "Cancel", class: "btn btn-secondary" do %>
                                    <i class="fas fa-times"></i> Cancel
                                    <% end %>
                                </div>
                                <% end %>

                            </div>
                        </div>
                    </div>
                </div>
                