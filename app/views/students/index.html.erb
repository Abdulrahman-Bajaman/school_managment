<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><i class="fas fa-users"></i> Students Management</h2>
  <%= link_to 'Add New Student', class: "btn btn-primary" do %>
    <i class="fas fa-user-plus"></i> Add New Student
  <% end %>
</div>

<!-- Students Table -->
<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Student Full Name</th>
        <th>School arabic name</th>
        <th>School arabic name</th>

        <th>Status</th>
        <th>Date of Birth</th>
        <th>Mobile</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
    <% if @students.any? %>
        <% @students.each do |student| %>
        <tr>
            <td><%= student.full_name %></td>
            <td><%= student.school&.name_ar || "N/A" %></td>
            <td><%= student.school&.name_en || "N/A" %></td>
            <td>
            <% if student.status? %>
                <span class="status-inactive">Inactive</span>
            <% else %>
                <span class="status-active">Active</span>
            <% end %>
            </td>
            <td><%= student.date_of_birth %></td>
            <td><%= student.phone_number %></td>
            <td>
            <%= link_to "#", class: "btn btn-info btn-sm" do %>
                <i class="fas fa-eye"></i>
            <% end %>
            <%= link_to "#", class: "btn btn-warning btn-sm" do %>
                <i class="fas fa-edit"></i>
            <% end %>
            <%= link_to "#", method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" do %>
                <i class="fas fa-trash"></i>
            <% end %>
            </td>
        </tr>
        <% end %>
    <% else %>
        <tr>
        <td colspan="7" class="text-center">No students found.</td>
        </tr>
    <% end %>
    </tbody>

  </table>
</div>
