<% flash.each do |key, message| %>
  <% alert_class = case key.to_sym
    when :success then "alert-success"
    when :error then "alert-danger"
    else "alert-info"
  end %>
  <div class="alert <%= alert_class %>">
    <%= message %>
  </div>
<% end %>

     <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h3><i class="fas fa-user-plus"></i> Add New Student</h3>
                            </div>
                            <div class="card-body">
                           <%= form_with model: @student, local: true do |f| %>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                        <%= f.label :full_name, "Full Name *", class: "form-label" %>
                                        <%= f.text_field :full_name, class: "form-control", required: true %>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                        <%= f.label :school_id, "School *", class: "form-label" %>
                                        <%= f.select :school_id, options_from_collection_for_select(@schools, :id, :name_ar), {prompt: "Select School"}, class: "form-select", required: true %>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                        <%= f.label :status, "Status *", class: "form-label" %>
                                        <%= f.select :status, Student.statuses.keys.map {|s| [s.titleize, s]}, {prompt: "Select Status"}, class: "form-select", required: true %>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                        <%= f.label :date_of_birth, "Date of Birth *", class: "form-label" %>
                                        <%= f.date_field :date_of_birth, class: "form-control", required: true %>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                        <%= f.label :address, "Address *", class: "form-label" %>
                                        <%= f.text_field :address, class: "form-control", required: true %>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                        <%= f.label :phone_number, "Mobile *", class: "form-label" %>
                                        <%= f.telephone_field :phone_number, class: "form-control", required: true %>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <%= f.submit "Save Student", class: "btn btn-primary" %>
                                        <%= link_to "Cancel", students_path, class: "btn btn-secondary" %>
                                    </div>
                                    <% end %>

                            </div>
                        </div>
                    </div>
                </div>
                