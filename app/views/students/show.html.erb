<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3><i class="fas fa-user"></i> Student Details</h3>
        <div>
          <%= link_to edit_student_path(@student), class: "btn btn-primary btn-sm" do %>
            <i class="fas fa-edit"></i> Edit
          <% end %>
          <%= link_to students_path, class: "btn btn-secondary btn-sm" do %>
            <i class="fas fa-arrow-left"></i> Back
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <strong>Full Name:</strong>
            <p class="mb-0"><%= @student.full_name %></p>
          </div>
          <div class="col-md-6 mb-3">
            <strong>School:</strong>
            <p class="mb-0"><%= @student.school&.name_en %></p>
          </div>
          <div class="col-md-6 mb-3">
            <strong>Status:</strong>
            <p class="mb-0">
           <span class="status-<%= @student.status == 0 ? 'active' : 'inactive' %>">
            <%= @student.status == 0 ? 'Active' : 'Inactive' %>
           </span>

            </p>
          </div>
          <div class="col-md-6 mb-3">
            <strong>Date of Birth:</strong>
            <p class="mb-0"><%= @student.date_of_birth %></p>
          </div>
          <div class="col-md-6 mb-3">
            <strong>Address:</strong>
            <p class="mb-0"><%= @student.address %></p>
          </div>
          <div class="col-md-6 mb-3">
            <strong>Mobile:</strong>
            <p class="mb-0"><%= @student.phone_number %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

